{
  "name": "dsh-upm",
  "version": "0.1.1",
  "description": "ui-ux-pro-max 的 DeepSeek Harness 原生插件：技能随包走，上游搜索脚本注册成原生工具与命令，数据可随上游自动重新封装",
  "license": "MIT",
  "author": "dsh-upm contributors",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "ui-ux-pro-max",
    "design",
    "design-system",
    "ux",
    "typography",
    "color-palette"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "cordis.patch.yml",
    "docs",
    "lib",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.0-rc.2"
  }
}
